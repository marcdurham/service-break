# Copy to .env and fill in a real password before deploying.
# Read locally by `docker compose` to interpolate docker-compose.yml before
# sending build/run instructions to the remote Docker daemon — never copied
# to the server itself.
POSTGRES_USER=service_break
POSTGRES_PASSWORD=changeme-use-a-strong-password
POSTGRES_DB=service_break

# Optional: "Sign in with Google". Leave all three unset to keep it
# disabled. See DEPLOY.md for how to create these in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Credentials for the OpenObserve container (log aggregation). Change the
# password before deploying — it's also the login for the OpenObserve web
# UI at http://<server>:5080. See DEPLOY.md for details.
OPENOBSERVE_USER=admin@example.com
OPENOBSERVE_PASSWORD=changeme-use-a-strong-password
